# ==============================================================
# Junior DevOps Agent Engine — Configuration
# ==============================================================

# LLM Provider: 'gemini' | 'openai' | 'kimi' | 'anthropic' | 'ollama'
LLM_PROVIDER=gemini

# Model name (e.g., gemini-2.5-flash, gpt-4o, moonshot-v1-auto, claude-3-7-sonnet-20250219, llama3:8b)
LLM_MODEL=gemini-2.5-flash

# API Keys (set the key for your selected provider)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# MOONSHOT_API_KEY=your_kimi_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Base URL override (e.g. for Ollama: http://localhost:11434/v1 or custom proxy)
# LLM_BASE_URL=
